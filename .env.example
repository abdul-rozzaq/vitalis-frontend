# Backend URL used by the server-side proxy routes (app/api/[...path], app/uploads/[...path])
API_BASE_URL=http://localhost:4000/api

# Backend URL used by the browser (Axios baseURL). Must include /api.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# QZ Tray receipt printing - RSA private key (base64-encoded PEM), used to sign
# requests so QZ Tray trusts this app and stops showing the "Allow" popup.
# Local dev: leave empty, falls back to src/server/qz-keys/private-key.pem.
# Docker/production: required, since that file is not shipped in the standalone build.
QZ_PRIVATE_KEY=
